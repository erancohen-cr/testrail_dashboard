# Shared readonly TestRail account (default for everyone)
TESTRAIL_URL=https://cybereasonqa.testrail.io
TESTRAIL_RO_EMAIL=
TESTRAIL_RO_KEY=
# Encrypts personal TestRail keys stored in cookies. Generate: openssl rand -base64 32
APP_SECRET=
# Optional
CACHE_TTL_S=300
DATA_DIR=./data
# Set to 1 only if served over plain http (cookies are Secure in production otherwise)
INSECURE_COOKIES=
